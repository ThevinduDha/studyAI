# Server Environment Configuration Template
# Copy this file to .env and replace placeholder values

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=your_mongodb_connection_string_placeholder

# Authentication
JWT_SECRET=your_jwt_secret_placeholder
JWT_EXPIRES_IN=7d

# Google Gemini AI (Phase 5)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Semantic Retrieval (Phase 6)
RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MAX_QUERY_LENGTH=2000
RETRIEVAL_NUM_CANDIDATES=50

# Grounded RAG & Generation (Phase 7)
GEMINI_GENERATION_MODEL=gemini-2.0-flash
RAG_MAX_CONTEXT_CHARS=12000
RAG_MIN_RELEVANCE_SCORE=0.0
RAG_TEMPERATURE=0.2




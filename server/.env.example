# Server Environment Configuration Template
# Copy this file to .env and replace placeholder values

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=your_mongodb_connection_string_placeholder

# Authentication
JWT_SECRET=your_jwt_secret_placeholder
JWT_EXPIRES_IN=7d

# Google Gemini AI (Future Phase)
GEMINI_API_KEY=your_gemini_api_key_placeholder

